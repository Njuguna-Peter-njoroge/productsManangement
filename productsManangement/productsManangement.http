# 🚀 STEP 1: CHANGE THIS PORT (8090) to match your active browser address bar!
# (Example: http://localhost:5076 if that's what Visual Studio opened)
@productsManangement_HostAddress = http://localhost:8090

### 1. Get all products
GET {{productsManangement_HostAddress}}/api/products
Accept: application/json

### 2. Create a product (Run this FIRST to seed your database)
POST {{productsManangement_HostAddress}}/api/products
Accept: application/json
Content-Type: application/json

{
  "name": "Product 3",
  "description": "Description of Product 3",
  "price": 15.00
}

### 3. Get product by id
GET {{productsManangement_HostAddress}}/api/products/1
Accept: application/json

### 4. Update product 
PUT {{productsManangement_HostAddress}}/api/products/1
Accept: application/json
Content-Type: application/json

{
  "name": "Updated Product Name",
  "description": "Updated Description",
  "price": 19.99
}

### 5. Delete product
DELETE {{productsManangement_HostAddress}}/api/products/1
Accept: application/json
